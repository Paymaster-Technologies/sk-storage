# Copy to .env next to docker-compose.yml. All values are optional.

# Byte budget per storage-id (sum of object sizes). Suffixes KiB/MiB/GiB ok.
QUOTA_BYTES=1GiB

# Largest single object accepted. Secret Keeper archive files are small
# except Vault file attachments (.storage/files/*.skf).
MAX_OBJECT_BYTES=512MiB

# Accepted difference between client and server clocks, milliseconds.
SKEW_MS=300000
