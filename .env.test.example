# Copy to .env.test for the `storage-test` service (docker compose --profile
# test). A public host for testers: one seed at a time and a small quota, so
# a stranger cannot fill the disk and the "server accepts no new users" and
# "quota exceeded" paths get exercised.
QUOTA_BYTES=64MiB
MAX_OBJECT_BYTES=16MiB
SKEW_MS=300000
MAX_STORAGE_IDS=1
